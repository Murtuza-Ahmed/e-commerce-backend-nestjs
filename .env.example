# Al-ucaaz API — Phase 1 (Users, Auth, OTP, dynamic RBAC)
# .env me copy karo aur asli values bharo. .env kabhi commit mat karo.

# ---------- Server ----------
PORT=3000

# ---------- Database (Neon PostgreSQL) ----------
# Neon ka connection string — aakhir me ?sslmode=require lazmi
# Masalan: postgresql://user:pass@ep-xxx.neon.tech/al_ucaaz?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/database
# Sirf PEHLI dafa tables banane ke liye true (npm run start:dev ek dafa),
# phir foran false. Production me kabhi true mat rakho.
DATABASE_SYNC=false
DATABASE_LOGGING=false

# ---------- JWT (lazmi — 16+ characters, random) ----------
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret-min-16
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Email OTP (signup verify / password reset) ----------
# Koi bhi SMTP provider: Gmail App Password, Resend, SendGrid, SES...
# Na ho to DEV MODE: OTP terminal par print hoga (production me lazmi lagao)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@al-ucaaz.com

# ---------- OTP settings ----------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Production me lazmi badlo
OTP_SECRET=change-me-to-a-random-secret

# ---------- SMS OTP (forgot-email flow) ----------
# Twilio na ho to DEV MODE: OTP terminal par print hoga
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Cloudinary (image uploads: /api/uploads + user avatars) ----------
# Na ho to upload endpoints saaf 400 denge. Free: cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=al-ucaaz

# ---------- Pehla super admin (npm run seed) ----------
SUPER_ADMIN_EMAIL=admin@al-ucaaz.com
SUPER_ADMIN_PASSWORD=change-me-strong-password-min-8

# ---------- Misc ----------
# "*" ya comma-separated domains, masalan https://al-ucaaz.com,https://www.al-ucaaz.com
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:5173
